  submittedAt   DateTime @default(now()) @map("submitted_at") @db.Timestamptz

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("inbound_client_mandates")
}

model StorefrontTalentShowcase {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @map("showcase_id") @db.Uuid
  agencyId           String   @map("agency_id") @db.Uuid
  candidateId        String   @map("candidate_id") @db.Uuid
  anonymizedHeadline String   @map("anonymized_headline") @db.VarChar(255)
  skillsTeaser       String[] @map("skills_teaser")
  isFeatured         Boolean  @default(true) @map("is_featured")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  agency    Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  candidate CandidateRecord @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("storefront_talent_showcases")
}

model StorefrontCandidateApplication {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @map("app_id") @db.Uuid
  agencyId      String   @map("agency_id") @db.Uuid
  fullName      String   @map("full_name") @db.VarChar(255)
  email         String   @db.VarChar(255)
  phone         String   @db.VarChar(32)
  resumeFileUrl String   @map("resume_file_url") @db.VarChar(512)
  appliedAt     DateTime @default(now()) @map("applied_at") @db.Timestamptz

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("storefront_candidate_applications")
}

// =============================================================================
// CROSS-DOMAIN SYSTEMS (ACTIVITY, QUEUE, FILE STORAGE)
// =============================================================================

model SystemActivityLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @map("activity_id") @db.Uuid
  agencyId   String   @map("agency_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String   @map("actor_role") @db.VarChar(64)
  eventType  String   @map("event_type") @db.VarChar(128)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([agencyId, entityType, entityId, createdAt(sort: Desc)])
  @@index([agencyId, eventType, createdAt(sort: Desc)])
  @@map("system_activity_logs")
}

model NotificationQueue {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @map("notification_id") @db.Uuid
  agencyId            String              @map("agency_id") @db.Uuid
  channel             NotificationChannel
  recipientIdentifier String              @map("recipient_identifier") @db.VarChar(255)
  payloadJson         Json                @map("payload_json")
  dispatchStatus      DispatchStatus      @default(PENDING) @map("dispatch_status")
  retryCount          Int                 @default(0) @map("retry_count")
  errorLog            String?             @map("error_log")
  scheduledAt         DateTime            @default(now()) @map("scheduled_at") @db.Timestamptz
  dispatchedAt        DateTime?           @map("dispatched_at") @db.Timestamptz
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([dispatchStatus, scheduledAt])
  @@index([agencyId, createdAt(sort: Desc)])
  @@map("notification_queues")
}

model FileStorageRecord {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @map("file_id") @db.Uuid
  agencyId         String   @map("agency_id") @db.Uuid
  bucketName       String   @map("bucket_name") @db.VarChar(128)
  storagePath      String   @map("storage_path") @db.VarChar(512)
  originalFileName String   @map("original_file_name") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(128)
  fileSizeBytes    Int      @map("file_size_bytes")
  isVirusScanned   Boolean  @default(false) @map("is_virus_scanned")
  uploadedAt       DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("file_storage_records")
}
