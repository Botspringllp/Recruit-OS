// =============================================================================
// RecruitOS - Complete Prisma Schema Specification (Prisma 5+ / Stable)
// Database Engine: PostgreSQL (Supabase Compatible)
// Multi-Tenancy: Row Level Security (RLS) Ready via agencyId
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUM MAPPINGS
// =============================================================================

enum MandateStatus {
  DRAFT
  OPEN
  ACTIVE
  ON_HOLD
  PAUSED
  FILLED
  CLOSED
  CANCELLED

  @@map("mandate_status")
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  EXPIRED

  @@map("agency_status")
}

enum SubscriptionTier {
  STARTER
  GROWTH
  ENTERPRISE

  @@map("tier")
}

enum UserRole {
  SUPER_ADMIN
  MASTER_OWNER
  AGENCY_OWNER
  AGENCY_FOUNDER
  RECRUITER
  FINANCE_MANAGER
  FINANCE_ADMIN
  COMPLIANCE_OFFICER
  INTERVIEW_COORDINATOR
  CLIENT_HR
  PARTNER_RECRUITER

  @@map("user_role")
}

enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("user_status")
}

enum CandidateSource {
  DIRECT_INTAKE
  PARTNER
  STOREFRONT
  SILVER_MEDALIST

  @@map("candidate_source")
}

enum CandidateOwnershipStatus {
  ACTIVE
  STALE
  UNASSIGNED

  @@map("candidate_ownership_status")
}

enum PipelineStage {
  SCREENED
  SUBMITTED_TO_CLIENT
  INTERVIEW_SCHEDULED
  OFFER_EXTENDED
  COMPLIANCE_AUDIT
  JOINED
  REJECTED

  @@map("pipeline_stage")
}

enum SlaStatus {
  ON_TRACK
  HEALTHY
  AT_RISK
  WARNING
  BREACHED

  @@map("sla_status")
}

enum CounterOfferRisk {
  LOW
  MEDIUM
  HIGH

  @@map("counter_offer_risk")
}

enum InvoiceStatus {
  GENERATED
  SENT_TO_CLIENT
  OVERDUE
  PAID
  CANCELLED

  @@map("invoice_status")
}

enum SettlementStatus {
  UNBILLED
  AWAITING_COLLECTION
  READY_FOR_PAYOUT
  SETTLED

  @@map("settlement_status")
}

enum CommChannel {
  WHATSAPP
  EMAIL

  @@map("comm_channel")
}

enum CommDirection {
  INBOUND
  OUTBOUND

  @@map("comm_direction")
}

enum CommDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED

  @@map("comm_delivery_status")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  IN_APP

  @@map("notification_channel")
}

enum DispatchStatus {
  PENDING
  PROCESSING
  DISPATCHED
  FAILED

  @@map("dispatch_status")
}

enum DocCategory {
  RAW_RESUME
  SANITIZED_RESUME
  PORTFOLIO
  COMPLIANCE_ID
  RELIEVING_LETTER
  OFFER_LETTER

  @@map("doc_category")
}

// =============================================================================
enum InterviewType {
  INTERNAL_SCREENING
  CLIENT_ROUND_1
  CLIENT_ROUND_2
  TECHNICAL_ASSESSMENT
  HR_ROUND
  FINAL_MANAGERIAL

  @@map("interview_type")
}

enum InterviewMode {
  GOOGLE_MEET
  MS_TEAMS
  ZOOM
  PHONE
  IN_PERSON

  @@map("interview_mode")
}

// DOMAIN 1: IDENTITY & AGENCY CORE
// =============================================================================

model Agency {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @map("agency_id") @db.Uuid
  name             String           @db.VarChar(255)
  subdomain        String           @unique @db.VarChar(63)
  status           AgencyStatus     @default(ACTIVE)
  subscriptionTier SubscriptionTier @default(ENTERPRISE) @map("tier")
  ownerId          String?          @map("owner_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz

  users                  User[]
  userRoles              UserRoleAssignment[]
  branding               AgencyBranding?
  jobBoardCredentials    AgencyJobBoardCredential[]
  clients                Client[]
  clientContacts         ClientContact[]
  jobMandates            JobMandate[]
  jobPrepKits            JobPrepKit[]
  candidates             CandidateRecord[]
  candidateDocuments     CandidateDocument[]
  candidateRelationships CandidateRelationship[]
  ownershipLogs          CandidateOwnershipLog[]
  submissions            CandidateSubmission[]
  slaLogs                PipelineSlaLog[]
  commTemplates          CommunicationTemplate[]
  commLogs               CommunicationLog[]
  clientPortalTokens     ClientPortalToken[]
  proposedSlots          ProposedInterviewSlot[]
  interviewSchedules     InterviewSchedule[]
  candidatePrepLogs      CandidatePrepLog[]
  interviewFeedback      CandidateInterviewFeedback[]
  noticeTrackers         NoticePeriodTracker[]
  noticePulseResponses   NoticePeriodPulseResponse[]
  complianceDocs         CandidateComplianceDoc[]
  complianceAuditLogs    ComplianceAuditLog[]
  jobOfferAudits         JobOfferAudit[]
  clientHrHandoffs       ClientHrHandoff[]
  probationTrackers      ProbationGuaranteeTracker[]
  partnerAgencies        PartnerAgency[]
  partnerShares          PartnerMandateShare[]
  partnerSubmissions     PartnerCandidateSubmission[]
  arbitrations           CandidateOwnershipArbitration[]
  partnerSplits          PartnerSplitLedger[]
  invoices               InvoiceRecord[]
  vouchers               FinancialVoucher[]
  financialAuditLogs     FinancialAuditLog[]
  storefrontProfile      AgencyStorefrontProfile?
  inboundLeads           InboundClientMandate[]
  storefrontShowcases    StorefrontTalentShowcase[]
  storefrontApplications StorefrontCandidateApplication[]
  activityLogs           SystemActivityLog[]
  notifications          NotificationQueue[]
  fileStorageRecords     FileStorageRecord[]

  @@map("agencies")
}

model User {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  agencyId     String      @map("agency_id") @db.Uuid
  email        String      @unique @db.VarChar(255)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  firstName    String      @map("first_name") @db.VarChar(128)
  lastName     String      @map("last_name") @db.VarChar(128)
  phone        String?     @db.VarChar(32)
  role         UserRole    @default(RECRUITER)
  status       UserStatus  @default(ACTIVE)
  isActive     Boolean     @default(true) @map("is_active")
  managerId    String?     @map("manager_id") @db.Uuid
  lastLoginAt  DateTime?   @map("last_login_at") @db.Timestamptz
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz

  agency                 Agency                          @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  manager                User?                           @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports          User[]                          @relation("UserManager")
  permissions            UserPermission[]
  userRoles              UserRoleAssignment[]
  authSessions           AuthSession[]
  assignedCandidates     CandidateRecord[]               @relation("RecruiterCandidateOwner")
  // ledJobMandates JobMandate[]
  ownershipLogsPrevious  CandidateOwnershipLog[]         @relation("PreviousRecruiterOwnership")
  ownershipLogsNew       CandidateOwnershipLog[]         @relation("NewRecruiterOwnership")
  sentCommLogs           CommunicationLog[]
  verifiedComplianceDocs CandidateComplianceDoc[]
  auditedOfferAudits     JobOfferAudit[]
  arbitrationsAsExisting CandidateOwnershipArbitration[] @relation("ArbitrationExistingRecruiter")
  modifiedFinancialLogs  FinancialAuditLog[]
  activities             SystemActivityLog[]

  @@index([agencyId, createdAt(sort: Desc)])
  @@map("users")
}

model UserPermission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @map("permission_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  resource  String   @db.VarChar(128)
  action    String   @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, action], name: "ux_user_permissions")
  @@map("user_permissions")
}

model UserRoleAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @map("role_assignment_id") @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleName  UserRole @map("role_name")
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleName], name: "ux_user_roles_user_role")
  @@map("user_roles")
}

model AuthSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(255)
  ipAddress        String   @map("ip_address") @db.Inet
  userAgent        String?  @map("user_agent")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

// =============================================================================
// DOMAIN 2: AGENCY BRANDING & INTEGRATIONS
// =============================================================================

model AgencyBranding {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @map("branding_id") @db.Uuid
  agencyId     String   @unique @map("agency_id") @db.Uuid
  logoUrl      String?  @map("logo_url") @db.VarChar(512)
  faviconUrl   String?  @map("favicon_url") @db.VarChar(512)
  primaryColor String   @default("#0F172A") @map("primary_color") @db.VarChar(16)
  accentColor  String   @default("#2563EB") @map("accent_color") @db.VarChar(16)
  customDomain String?  @map("custom_domain") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("agency_branding")
}

model AgencyJobBoardCredential {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @map("credential_id") @db.Uuid
  agencyId        String   @map("agency_id") @db.Uuid
  platformName    String   @map("platform_name") @db.VarChar(64)
  encryptedApiKey String   @map("encrypted_api_key")
  accountUsername String?  @map("account_username") @db.VarChar(128)
  isEnabled       Boolean  @default(true) @map("is_enabled")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, platformName], name: "ux_job_board_tenant_platform")
  @@map("agency_job_board_credentials")
}

// =============================================================================
// DOMAIN 3: CANDIDATE DOMAIN
// =============================================================================

model CandidateRecord {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @map("candidate_id") @db.Uuid
  agencyId             String                   @map("agency_id") @db.Uuid
  assignedRecruiterId  String?                  @map("assigned_recruiter_id") @db.Uuid
  firstName            String                   @map("first_name") @db.VarChar(128)
  lastName             String                   @map("last_name") @db.VarChar(128)
  email                String                   @db.VarChar(255)
  phone                String                   @db.VarChar(32)
  currentCompany       String?                  @map("current_company") @db.VarChar(255)
  currentDesignation   String?                  @map("current_designation") @db.VarChar(255)
  totalExperienceYears Decimal?                 @map("total_experience_years") @db.Decimal(4, 1)
  noticePeriodDays     Int                      @default(60) @map("notice_period_days")
  currentCtcLpa        Decimal?                 @map("current_ctc_lpa") @db.Decimal(10, 2)
  expectedCtcLpa       Decimal?                 @map("expected_ctc_lpa") @db.Decimal(10, 2)
  currentLocation      String?                  @map("current_location") @db.VarChar(128)
  preferredLocations   String[]                 @map("preferred_locations")
  primarySkills        String[]                 @default([]) @map("primary_skills")
  sanitizedSummary     String?                  @map("sanitized_summary")
  source               CandidateSource          @default(DIRECT_INTAKE)
  ownershipStatus      CandidateOwnershipStatus @default(ACTIVE) @map("ownership_status")
  lastActivityAt       DateTime                 @default(now()) @map("last_activity_at") @db.Timestamptz
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?                @map("deleted_at") @db.Timestamptz

  agency                 Agency                       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  assignedRecruiter      User?                        @relation("RecruiterCandidateOwner", fields: [assignedRecruiterId], references: [id], onDelete: SetNull)
  documents              CandidateDocument[]
  complianceDocs         CandidateComplianceDoc[]
  relationshipsAsPrimary CandidateRelationship[]      @relation("PrimaryCandidateRel")
  relationshipsAsRelated CandidateRelationship[]      @relation("RelatedCandidateRel")
  ownershipLogs          CandidateOwnershipLog[]
  submissions            CandidateSubmission[]
  commLogs               CommunicationLog[]
  partnerSubmissions     PartnerCandidateSubmission[]
  storefrontShowcases    StorefrontTalentShowcase[]

  @@unique([agencyId, phone], name: "ux_candidate_agency_phone")
  @@unique([agencyId, email], name: "ux_candidate_agency_email")
  @@index([agencyId, createdAt(sort: Desc)])
  @@map("candidate_records")
}

model CandidateDocument {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @map("document_id") @db.Uuid
  agencyId      String      @map("agency_id") @db.Uuid
  candidateId   String      @map("candidate_id") @db.Uuid
  documentType  DocCategory @map("document_type")
  filePath      String      @map("file_path") @db.VarChar(512)
  fileName      String      @map("file_name") @db.VarChar(255)
  fileSizeBytes Int         @map("file_size_bytes")
  mimeType      String      @map("mime_type") @db.VarChar(128)
  parsedJson    Json?       @map("parsed_json")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  agency    Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  candidate CandidateRecord @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, documentType])
  @@map("candidate_documents")
}

model CandidateRelationship {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @map("relationship_id") @db.Uuid
  agencyId           String   @map("agency_id") @db.Uuid
  candidateId        String   @map("candidate_id") @db.Uuid
  relatedCandidateId String   @map("related_candidate_id") @db.Uuid
  relationshipType   String   @map("relationship_type") @db.VarChar(64)
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  agency           Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  candidate        CandidateRecord @relation("PrimaryCandidateRel", fields: [candidateId], references: [id], onDelete: Cascade)
  relatedCandidate CandidateRecord @relation("RelatedCandidateRel", fields: [relatedCandidateId], references: [id], onDelete: Cascade)

  @@map("candidate_relationships")
}

model CandidateOwnershipLog {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @map("log_id") @db.Uuid
  agencyId            String   @map("agency_id") @db.Uuid
  candidateId         String   @map("candidate_id") @db.Uuid
  previousRecruiterId String?  @map("previous_recruiter_id") @db.Uuid
  newRecruiterId      String   @map("new_recruiter_id") @db.Uuid
  reason              String
  transferredAt       DateTime @default(now()) @map("transferred_at") @db.Timestamptz

  agency            Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  candidate         CandidateRecord @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  previousRecruiter User?           @relation("PreviousRecruiterOwnership", fields: [previousRecruiterId], references: [id], onDelete: SetNull)
  newRecruiter      User            @relation("NewRecruiterOwnership", fields: [newRecruiterId], references: [id], onDelete: Restrict)

  @@map("candidate_ownership_logs")
}

// =============================================================================
// DOMAIN 4: RECRUITMENT PIPELINE DOMAIN
// =============================================================================

model Client {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @map("client_id") @db.Uuid
  agencyId              String    @map("agency_id") @db.Uuid
  companyName           String    @map("company_name") @db.VarChar(255)
  industry              String?   @db.VarChar(128)
  website               String?   @db.VarChar(255)
  standardFeePercentage Decimal   @default(8.33) @map("standard_fee_percentage") @db.Decimal(5, 2)
  paymentTermsDays      Int       @default(30) @map("payment_terms_days")
  status                String    @default("ACTIVE") @db.VarChar(32)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz

  agency   Agency          @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  contacts ClientContact[]
  mandates JobMandate[]
  invoices InvoiceRecord[]

  @@index([agencyId, companyName])
  @@map("clients")
}

model ClientContact {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @map("contact_id") @db.Uuid
  agencyId    String   @map("agency_id") @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  name        String   @db.VarChar(255)
  email       String   @db.VarChar(255)
  phone       String?  @db.VarChar(32)
  designation String?  @db.VarChar(128)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_contacts")
}

model JobMandate {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @map("mandate_id") @db.Uuid
  agencyId      String        @map("agency_id") @db.Uuid
  clientId      String?       @map("client_id") @db.Uuid
  title         String        @db.VarChar(255)
  headcount     Int           @default(1)
  minCtcLpa     Decimal?      @map("min_ctc_lpa") @db.Decimal(10, 2)
  maxCtcLpa     Decimal?      @map("max_ctc_lpa") @db.Decimal(10, 2)
  feePercentage Decimal?      @default(8.33) @map("fee_percentage") @db.Decimal(5, 2)
  status        MandateStatus @default(OPEN)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  agency            Agency                      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client            Client?                     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  submissions       CandidateSubmission[]
  prepKits          JobPrepKit[]
  partnerShares     PartnerMandateShare[]
  portalTokens      ClientPortalToken[]
  commLogs          CommunicationLog[]
  probationTrackers ProbationGuaranteeTracker[] @relation("ReplacementMandateRel")

  @@map("job_mandates")
}

model JobPrepKit {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @map("kit_id") @db.Uuid
  agencyId         String   @map("agency_id") @db.Uuid
  jobId            String   @map("mandate_id") @db.Uuid
  companyOverview  String   @map("company_overview")
  interviewProcess String   @map("interview_process")
  behavioralTips   String?  @map("behavioral_tips")
  technicalFaqs    String?  @map("technical_faqs")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  agency Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  job    JobMandate @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_prep_kits")
}

model CandidateSubmission {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @map("submission_id") @db.Uuid
  agencyId      String        @map("agency_id") @db.Uuid
  jobId         String        @map("mandate_id") @db.Uuid
  candidateId   String        @map("candidate_id") @db.Uuid
  stage         PipelineStage @default(SCREENED)
  slaStatus     SlaStatus     @default(HEALTHY) @map("sla_status")
  offeredCtcLpa Decimal?      @map("offered_ctc_lpa") @db.Decimal(10, 2)
  joiningDate   DateTime?     @map("joining_date") @db.Date
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  agency             Agency                     @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  job                JobMandate                 @relation(fields: [jobId], references: [id], onDelete: Restrict)
  candidate          CandidateRecord            @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  slaLogs            PipelineSlaLog[]
  proposedSlots      ProposedInterviewSlot[]
  interviewSchedules InterviewSchedule[]
  noticeTracker      NoticePeriodTracker?
  complianceDocs     CandidateComplianceDoc[]
  offerAudit         JobOfferAudit?
  clientHrHandoffs   ClientHrHandoff[]
  probationTracker   ProbationGuaranteeTracker?
  partnerSplits      PartnerSplitLedger[]

  @@unique([jobId, candidateId], name: "ux_submission_job_candidate")
  @@index([agencyId, stage])
  @@index([stage])
  @@map("candidate_submissions")
}

model PipelineSlaLog {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @map("sla_log_id") @db.Uuid
  agencyId              String         @map("agency_id") @db.Uuid
  submissionId          String         @map("submission_id") @db.Uuid
  previousStage         PipelineStage? @map("previous_stage")
  newStage              PipelineStage  @map("new_stage")
  timeInStageHours      Int            @default(0) @map("time_in_stage_hours")
  slaStatusAtTransition SlaStatus      @default(HEALTHY) @map("sla_status_at_transition")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz

  agency     Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  submission CandidateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("pipeline_sla_logs")
}

model CommunicationTemplate {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @map("template_id") @db.Uuid
  agencyId        String      @map("agency_id") @db.Uuid
  channel         CommChannel
  name            String      @db.VarChar(128)
  subjectTemplate String?     @map("subject_template") @db.VarChar(255)
  bodyTemplate    String      @map("body_template")
  isApproved      Boolean     @default(true) @map("is_approved")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("communication_templates")
}

model CommunicationLog {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @map("log_id") @db.Uuid
  agencyId            String             @map("agency_id") @db.Uuid
  candidateId         String?            @map("candidate_id") @db.Uuid
  jobId               String?            @map("mandate_id") @db.Uuid
  sentByUserId        String?            @map("sent_by_user_id") @db.Uuid
  channel             CommChannel
  direction           CommDirection
